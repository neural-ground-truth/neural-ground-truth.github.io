---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

import type { MarkdownHeading } from 'astro';

type Props = CollectionEntry<'blog'>['data'] & {
	headings?: MarkdownHeading[];
};

const { title, description, pubDate, updatedDate, heroImage, headings } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			.layout-wrapper {
				display: flex;
				justify-content: center;
				max-width: 1100px;
				margin: 0 auto;
				position: relative;
			}
			article {
				padding: 2em 28px;
				width: 100%;
				max-width: 720px;
			}
			.toc-sidebar {
				width: 250px;
				padding: 2em 0 2em 2em;
				position: sticky;
				top: 80px;
				align-self: flex-start;
				height: max-content;
				max-height: calc(100vh - 100px);
				overflow-y: auto;
			}
			.toc-sidebar h4 {
				font-family: var(--sans);
				font-size: 13px;
				text-transform: uppercase;
				letter-spacing: 0.05em;
				color: var(--ink-dim);
				margin-bottom: 1.5em;
			}
			.toc-sidebar ul {
				list-style: none;
				padding: 0;
				margin: 0;
			}
			.toc-sidebar li {
				margin-bottom: 0.75em;
				line-height: 1.3;
			}
			.toc-sidebar li.depth-2 { margin-left: 0; }
			.toc-sidebar li.depth-3 { margin-left: 15px; font-size: 0.9em; }
			.toc-sidebar li.depth-4 { margin-left: 30px; font-size: 0.85em; }
			.toc-sidebar a {
				text-decoration: none;
				color: var(--ink-dim);
				font-size: 14px;
				border: none;
				transition: color 0.2s;
			}
			.toc-sidebar a:hover {
				color: var(--accent);
			}
			@media (max-width: 1000px) {
				.toc-sidebar { display: none; }
			}
			.hero-image {
				width: 100%;
				margin-bottom: 2em;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 8px;
			}
			.title {
				margin-bottom: 2em;
				line-height: 1.2;
			}
			.title h1 {
				margin: 0 0 0.2em 0;
				font-size: 56px;
				font-weight: 500;
				letter-spacing: -0.02em;
			}
			.date {
				margin-bottom: 1em;
				font-family: var(--mono);
				font-size: 0.9em;
				color: var(--ink-dim);
			}
			.last-updated-on {
				font-style: italic;
				margin-left: 10px;
			}
			.content {
				font-family: var(--serif);
				font-size: 21px;
				line-height: 1.8;
				color: var(--ink);
			}
			.content p {
				margin-bottom: 1.5em;
				color: var(--ink);
			}
			.content h2, .content h3, .content h4 {
				font-family: var(--sans);
				margin-top: 2em;
			}
			.citation-popover {
				position: absolute;
				background: var(--card-top);
				backdrop-filter: blur(20px);
				-webkit-backdrop-filter: blur(20px);
				border: 1px solid var(--line-soft);
				box-shadow: var(--shadow-md);
				padding: 16px;
				border-radius: 12px;
				max-width: 320px;
				font-size: 15px;
				color: var(--ink);
				z-index: 1000;
				opacity: 0;
				pointer-events: none;
				transform: translateY(10px);
				transition: opacity 0.2s ease, transform 0.2s ease;
				font-family: var(--sans);
				line-height: 1.5;
			}
			.citation-popover.visible {
				opacity: 1;
				pointer-events: auto;
				transform: translateY(0);
			}
			.citation-popover p {
				margin: 0 !important;
				font-size: 14.5px;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<div class="layout-wrapper">
				<article>
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<span class="last-updated-on">
										(Updated: <FormattedDate date={updatedDate} />)
									</span>
								)
							}
						</div>
						<h1>{title}</h1>
					</div>
					<div class="hero-image">
						{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
					</div>
					<div class="content">
						<slot />
					</div>
				</article>

				{headings && headings.length > 0 && (
					<aside class="toc-sidebar">
						<h4>Table of Contents</h4>
						<nav>
							<ul>
								{headings.map((heading) => (
									<li class={`depth-${heading.depth}`}>
										<a href={`#${heading.slug}`}>{heading.text}</a>
									</li>
								))}
							</ul>
						</nav>
					</aside>
				)}
			</div>
		</main>
		<Footer />

		<!-- Citation Popover Logic -->
		<div id="citation-popover" class="citation-popover"></div>
		<script is:inline>
			(function() {
				const popover = document.getElementById('citation-popover');
				let activeLink = null;

				// Close popover when clicking outside
				document.addEventListener('click', (e) => {
					if (!popover.contains(e.target) && e.target !== activeLink) {
						popover.classList.remove('visible');
						activeLink = null;
					}
				});

				// Find all footnote links
				const refs = document.querySelectorAll('a[data-footnote-ref]');
				refs.forEach(link => {
					link.addEventListener('click', (e) => {
						e.preventDefault();
						e.stopPropagation();

						// If clicking the same link, toggle off
						if (activeLink === link) {
							popover.classList.remove('visible');
							activeLink = null;
							return;
						}

						const targetId = link.getAttribute('href').substring(1);
						const footnoteEl = document.getElementById(targetId);
						
						if (footnoteEl) {
							// Clone it so we don't modify the DOM
							const clone = footnoteEl.cloneNode(true);
							
							// Remove the backreference link (usually a ↩ symbol)
							const backrefs = clone.querySelectorAll('.data-footnote-backref');
							backrefs.forEach(br => br.remove());
							
							popover.innerHTML = clone.innerHTML;
							
							// Position the popover near the click
							const rect = link.getBoundingClientRect();
							popover.style.top = (window.scrollY + rect.bottom + 10) + 'px';
							
							// Keep it on screen
							let leftPos = rect.left;
							if (leftPos + 320 > window.innerWidth) {
								leftPos = window.innerWidth - 340;
							}
							popover.style.left = Math.max(10, leftPos) + 'px';
							
							popover.classList.add('visible');
							activeLink = link;
						}
					});
				});
			})();
		</script>
	</body>
</html>
