---
const today = new Date();
---

<footer>
	<div class="wrap footer-content">
		<div class="foot-brand">&copy; {today.getFullYear()} AI Research</div>
	</div>
</footer>

<style>
	footer {
		padding: 32px 0 48px;
		border-top: 1px solid var(--line-soft);
		margin-top: 60px;
	}
	.footer-content {
		display: flex;
		justify-content: center;
		align-items: center;
	}
	.foot-brand {
		font-family: var(--mono);
		font-size: 12.5px;
		color: var(--ink-faint);
		letter-spacing: 0.02em;
	}
	.foot-links {
		display: flex;
		gap: 16px;
		align-items: center;
	}
	.foot-links a {
		font-family: var(--mono);
		font-size: 12px;
		color: var(--ink-faint);
		border: none;
		transition: color 0.18s ease;
	}
	.foot-links a:hover {
		color: var(--accent);
	}
</style>
