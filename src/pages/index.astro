---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			/* Hero Section Styles */
			header.hero {
				padding: 84px 0 36px;
			}
			.eyebrow {
				font-family: var(--mono);
				font-size: 12.5px;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: var(--accent-dim);
				margin-bottom: 16px;
				display: flex;
				align-items: center;
				gap: 10px;
			}
			.status-pill {
				display: inline-flex;
				align-items: center;
				gap: 7px;
				background: var(--pill-bg);
				border: 1px solid var(--pill-border);
				color: var(--accent);
				font-family: var(--mono);
				font-size: 11.5px;
				font-weight: 500;
				padding: 3px 10px;
				border-radius: 99px;
				letter-spacing: 0.02em;
			}
			.status-dot {
				width: 6px;
				height: 6px;
				border-radius: 50%;
				background-color: var(--accent);
				box-shadow: 0 0 8px var(--accent);
				animation: pulse 2s infinite;
			}
			@keyframes pulse {
				0% { opacity: 1; transform: scale(1); }
				50% { opacity: 0.4; transform: scale(1.15); }
				100% { opacity: 1; transform: scale(1); }
			}
			h1.name {
				font-family: var(--serif);
				font-weight: 500;
				font-size: 50px;
				line-height: 1.08;
				letter-spacing: -0.02em;
				margin: 0 0 16px;
				color: var(--ink);
			}
			.subtitle {
				font-family: var(--serif);
				font-style: italic;
				font-size: 22px;
				color: var(--ink-dim);
				margin: 0 0 20px;
				line-height: 1.42;
			}
			.affil {
				font-size: 15.5px;
				color: var(--ink-faint);
				margin: 0 0 28px;
				line-height: 1.6;
			}
			.hero-flex {
				display: flex;
				gap: 40px;
				align-items: flex-start;
			}
			.hero-text {
				flex: 1;
				min-width: 0;
				max-width: 720px;
			}

			/* Entries List Styles */
			section.content {
				padding: 42px 0;
			}
			.sec-label {
				font-family: var(--mono);
				font-size: 12px;
				letter-spacing: 0.09em;
				text-transform: uppercase;
				color: var(--accent-dim);
				margin: 0 0 20px;
				font-weight: 500;
			}
			.entry-link {
				display: block;
				text-decoration: none;
				border: none;
			}
			.entry {
				padding: 22px 0;
				border-top: 1px solid var(--line-soft);
				transition: background 0.2s ease;
			}
			.entry:first-of-type {
				border-top: none;
				padding-top: 8px;
			}
			.entry .meta {
				font-family: var(--mono);
				font-size: 12px;
				color: var(--ink-faint);
				letter-spacing: 0.02em;
				margin-bottom: 8px;
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 6px;
			}
			.entry .venue {
				color: var(--accent-dim);
				font-weight: 500;
			}
			.entry h3 {
				font-family: var(--sans);
				font-weight: 600;
				font-size: 18px;
				margin: 0 0 4px;
				color: var(--ink);
				transition: color 0.2s ease;
			}
			.entry-link:hover .entry h3 {
				color: var(--accent);
			}
			.entry p {
				margin: 8px 0 12px;
				font-size: 15.5px;
				line-height: 1.65;
				color: var(--ink-dim);
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<header class="hero">
				<div class="wrap">
					<div class="hero-flex">
						<div class="hero-text">
							<div class="eyebrow">
								<div class="status-pill">
									<span class="status-dot"></span>
									RESEARCH BLOG
								</div>
							</div>
							<h1 class="name">Neural Ground Truth</h1>
							<p class="subtitle">Where research meets intuition. Papers, concepts, and code — grounded.</p>
							<p class="affil">Deep dives into Attention, Tokenization, LLMs, and Multilingual Speech Architectures.</p>
						</div>
					</div>
				</div>
			</header>

			<section class="content">
				<div class="wrap">
					<h2 class="sec-label">Latest Notes</h2>
					<div class="posts-container">
						{
							posts.map((post) => (
								<a href={`/posts/${post.id}/`} class="entry-link">
									<div class="entry fade-in">
										<div class="meta">
											<FormattedDate date={post.data.pubDate} />
											• <span class="venue">Article</span>
										</div>
										<h3>{post.data.title}</h3>
										<p>{post.data.description}</p>
									</div>
								</a>
							))
						}
					</div>
				</div>
			</section>
		</main>
		<Footer />

		<script is:inline>
			// IntersectionObserver for smooth scroll fade-in animations
			(function () {
				var elements = document.querySelectorAll('.fade-in');
				if ('IntersectionObserver' in window) {
					var observer = new IntersectionObserver(function (entries) {
						entries.forEach(function (entry) {
							if (entry.isIntersecting) {
								entry.target.classList.add('visible');
								observer.unobserve(entry.target);
							}
						});
					}, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
					elements.forEach(function (el) { observer.observe(el); });
				} else {
					elements.forEach(function (el) { el.classList.add('visible'); });
				}
			})();
		</script>
		<style>
			.fade-in {
				opacity: 0;
				transform: translateY(12px);
				transition: opacity 0.5s ease, transform 0.5s ease;
			}
			.fade-in.visible {
				opacity: 1;
				transform: translateY(0);
			}
		</style>
	</body>
</html>
