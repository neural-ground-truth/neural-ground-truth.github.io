---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				margin: 3em 0 4em 0;
			}
			.hero h1 {
				font-size: 3em;
				margin-bottom: 0.2em;
			}
			.hero .tagline {
				font-size: 1.3em;
				color: var(--ink-dim);
				margin: 0;
			}
			ul.post-list {
				list-style: none;
				padding: 0;
				margin: 0;
			}
			ul.post-list li {
				margin-bottom: 2em;
			}
			ul.post-list a {
				display: block;
				text-decoration: none;
				border: none;
			}
			ul.post-list a:hover .title {
				color: var(--accent);
			}
			.title {
				font-size: 1.4em;
				font-weight: 600;
				color: var(--ink);
				margin: 0 0 0.2em 0;
				transition: color 0.2s;
			}
			.date {
				font-family: var(--mono);
				font-size: 0.85em;
				color: var(--ink-dim);
				margin-bottom: 0.5em;
			}
			.description {
				color: var(--ink-dim);
				margin: 0;
			}
			.section-title {
				font-size: 1.2em;
				text-transform: uppercase;
				letter-spacing: 0.05em;
				color: var(--accent);
				border-bottom: 2px solid var(--line);
				padding-bottom: 0.5em;
				margin-bottom: 1.5em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>Neural Ground Truth</h1>
				<p class="tagline">Where research meets intuition. Papers, concepts, and code — grounded.</p>
			</section>

			<h2 class="section-title">Latest Notes</h2>
			<section>
				<ul class="post-list">
					{
						posts.map((post) => (
							<li>
								<a href={`/posts/${post.id}/`}>
									<div class="date">
										<FormattedDate date={post.data.pubDate} />
									</div>
									<h4 class="title">{post.data.title}</h4>
									<p class="description">{post.data.description}</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
